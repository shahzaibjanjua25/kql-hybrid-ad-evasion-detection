// ============================================================
// Rule9-Detecting Shadow Credentials (msDS-KeyCredentialLink Abuse)
// ============================================================
// Description: Identifies modification of the msDS-KeyCredentialLink
// attribute on AD user or computer objects. Attackers abuse this
// "Shadow Credentials" technique to inject their own Key Trust key
// material into a target account, then authenticate via Kerberos
// PKINIT and obtain a TGT — enabling stealthy persistence, privilege
// escalation, and account takeover WITHOUT changing passwords or
// touching authentication policies.
//
// MITRE ATT&CK: T1098  (Account Manipulation)
//               T1556  (Modify Authentication Process)
//               T1649  (Steal or Forge Authentication Certificates)
// Data Source: Windows Security Events (Domain Controller audit logs)
// Author: [Your Name / Team]
// Validated: [To be validated]
//
// TUNING:
// - Populate `ApprovedOperators` with accounts authorized to write
//   msDS-KeyCredentialLink (e.g., Windows Hello for Business provisioning
//   service accounts, approved AD admins)
// - Populate `WhfbManagedAccounts` with users enrolled in WHfB Key Trust
// - Set `CorrelationWindow` to cover the window between write and PKINIT
// - Requires Group Policy: "Audit Directory Service Changes" +
//   "Audit Kerberos Authentication Service" on all DCs
// - Investigate Medium rows as hunting leads; prioritize High rows
// ============================================================

let TimeWindow = 24h;
let CorrelationWindow = 1h;
// GUID of the msDS-KeyCredentialLink attribute (used by 4662 object-access events)
let MsDsKeyCredentialLinkGuid = "5b47d60f-6090-40b2-9f37-2a4de88f3063";
let ApprovedOperators = dynamic(["svc_whfb", "<approved-admin>"]);
let WhfbManagedAccounts = dynamic(["<whfb-user1>", "<whfb-user2>"]);

// 1. Primary signal — msDS-KeyCredentialLink modified (5136)
let KeyCredWrites5136 =
    SecurityEvent
    | where TimeGenerated > ago(TimeWindow)
    | where EventID == 5136
    | where AttributeLDAPDisplayName == "msDS-KeyCredentialLink"
    | where SubjectUserName !in (ApprovedOperators)
    | extend TargetAccount = extract(@"CN=([^,]+)", 1, ObjectDN)
    | where TargetAccount !in (WhfbManagedAccounts)
    | project WriteTime = TimeGenerated, DC = Computer, Actor = SubjectUserName,
              TargetAccount, TargetDN = ObjectDN, EventID;

// 2. Supplementary signal — attribute-level write via 4662 (in case 5136 is unavailable)
let KeyCredWrites4662 =
    SecurityEvent
    | where TimeGenerated > ago(TimeWindow)
    | where EventID == 4662
    | where Properties has MsDsKeyCredentialLinkGuid
    | where EventData has "WriteProperty" or EventData has "0x20"
    | where SubjectUserName !in (ApprovedOperators)
    | extend TargetAccount = extract(@"CN=([^,]+)", 1, ObjectName)
    | where TargetAccount !in (WhfbManagedAccounts)
    | project WriteTime = TimeGenerated, DC = Computer, Actor = SubjectUserName,
              TargetAccount, TargetDN = ObjectName, EventID;

// 3. Correlation signal — subsequent Kerberos PKINIT TGT request for the same account
let PkinitLogons =
    SecurityEvent
    | where TimeGenerated > ago(TimeWindow)
    | where EventID == 4768
    | where tostring(PreAuthType) == "16"   // 16 = PKINIT
    | project AuthTime = TimeGenerated, Account, AuthDC = Computer;

union KeyCredWrites5136, KeyCredWrites4662
| join kind=leftouter PkinitLogons on $left.TargetAccount == $right.Account
| where isnull(AuthTime) or AuthTime between (WriteTime .. (WriteTime + CorrelationWindow))
| extend
    PostInjectionPkinit = isnotempty(AuthTime),
    AlertReason = iff(isnotempty(AuthTime),
        "Shadow Credentials: msDS-KeyCredentialLink modified followed by PKINIT TGT request",
        "Shadow Credentials: msDS-KeyCredentialLink modified (no PKINIT observed yet)"),
    Confidence = iff(isnotempty(AuthTime), "High", "Medium")
| project WriteTime, AuthTime, PostInjectionPkinit, DC, Actor,
          TargetAccount, TargetDN, AlertReason, Confidence
| order by PostInjectionPkinit desc, WriteTime desc
